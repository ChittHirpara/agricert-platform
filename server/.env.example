# ============================================
# AgriCert Server — Environment Variables
# Copy this file to .env and fill in values.
# ============================================

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/agricert

# JWT secret key (use a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Port for the Express server
PORT=5000

# Frontend URL for CORS whitelist (e.g. https://yourapp.vercel.app)
FRONTEND_URL=http://localhost:5173

# ---- Blockchain (Polygon Amoy Testnet) ----
# Your wallet's private key (NEVER commit this to git)
PRIVATE_KEY=0xyour_wallet_private_key

# Deployed AgriCert smart contract address
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Polygon Amoy RPC URL
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/
